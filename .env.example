# Optional for rendering. Leave unset for automatic Chromium discovery.
# CHROME_PATH=/usr/bin/chromium
# PLAYWRIGHT_BROWSERS_PATH=/absolute/path/to/playwright-browsers

# Only required for ElevenLabs narration; silent example renders need no keys.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Temporary public test mode. Set true to require login again.
PANEL_AUTH_ENABLED=false
# Preserved password: used only when PANEL_AUTH_ENABLED=true.
PANEL_PASSWORD=
# Optional stock provider. Add only PIXABAY_API_KEY to an existing .env; keep ElevenLabs settings.
# Get a key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Local development defaults. For a remote host use a TLS reverse proxy.
HOST=127.0.0.1
PORT=3000
# Set true when serving through HTTPS.
COOKIE_SECURE=false
RENDER_WIDTH=540
RENDER_FPS=15
